# Used by "npm run build". The Laravel public folder is served from /backend on the same
# domain as the storefront, so these are same-origin paths (no CORS, no http/https or www mismatch).
# If the backend is ever hosted elsewhere, put the full URLs here and rebuild, e.g.
#   VITE_API_URL=https://api.example.com/api
#   VITE_IMG_URL=https://api.example.com/assets/
VITE_API_URL=/backend/api
VITE_IMG_URL=/backend/assets/
VITE_BASE=/
