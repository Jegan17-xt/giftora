# Production settings. Copy to ".env" inside the application folder on the server
# and fill in the values marked CHANGE_ME. Never upload this file to a public folder.

APP_NAME=Giftora
APP_ENV=production
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://giftora.mita.in/backend

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# On cPanel the database and user names carry the account prefix (e.g. cpuser_giftora).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=mitaik1v_apps_mita_in_giftora
DB_USERNAME=mitaik1v_apps_mita_in_giftora
DB_PASSWORD="EFXBE6_m7@,J"

# File based, so no extra database tables or services are needed.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
